CREATE TABLE `sys_user` (
`id` BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',

`account` VARCHAR(50) NOT NULL UNIQUE COMMENT '账号',
`password` VARCHAR(255) NOT NULL COMMENT '密码',

`role` VARCHAR(20) NOT NULL COMMENT '角色：teacher/headmaster/student',

`gender` TINYINT DEFAULT 0 COMMENT '性别：0未知 1男 2女',

`email` VARCHAR(100) DEFAULT NULL COMMENT '邮箱',
`phone` VARCHAR(20) DEFAULT NULL COMMENT '手机号',

`description` VARCHAR(500) DEFAULT NULL COMMENT '描述',

`class_id` BIGINT DEFAULT NULL COMMENT '班级ID',

`status` TINYINT DEFAULT 1 COMMENT '状态：1正常 0禁用',

`create_by` BIGINT DEFAULT NULL COMMENT '创建人',
`create_time` DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',

`update_by` BIGINT DEFAULT NULL COMMENT '修改人',
`update_time` DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间'

) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='用户表';



CREATE TABLE `class_info` (
`id` BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',

`class_name` VARCHAR(100) NOT NULL COMMENT '班级名称',

`description` VARCHAR(500) DEFAULT NULL COMMENT '班级描述',

`status` TINYINT DEFAULT 1 COMMENT '状态：1正常 0禁用',

`create_by` BIGINT DEFAULT NULL COMMENT '创建人',
`create_time` DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',

`update_by` BIGINT DEFAULT NULL COMMENT '修改人',
`update_time` DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间'

) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='班级表';



CREATE TABLE `task` (
`id` BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',

`task_name` VARCHAR(200) NOT NULL COMMENT '任务名称',

`task_type` VARCHAR(50) NOT NULL COMMENT '任务类型',

`is_template` TINYINT DEFAULT 0 COMMENT '是否模板：1是 0否',

`template_task_id` BIGINT DEFAULT NULL COMMENT '模板任务ID',

`round_no` INT DEFAULT 0 COMMENT '轮次，模板为0',

`is_mandatory` TINYINT DEFAULT 0 COMMENT '是否强制任务：1强制 0非强制',

`task_description` TEXT COMMENT '任务描述',

`task_time` DATETIME DEFAULT NULL COMMENT '任务时间',

`priority` INT DEFAULT 0 COMMENT '任务优先级',

`class_id` BIGINT DEFAULT NULL COMMENT '班级ID',

`status` VARCHAR(20) DEFAULT 'unfinished' COMMENT '任务状态',

`completed_count` INT DEFAULT 0 COMMENT '已完成人数',

`uncompleted_count` INT DEFAULT 0 COMMENT '未完成人数',

`create_by` BIGINT DEFAULT NULL COMMENT '创建人',
`create_time` DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',

`update_by` BIGINT DEFAULT NULL COMMENT '修改人',
`update_time` DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间'

) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='任务表';



CREATE TABLE `task_user` (
`id` BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',

`task_id` BIGINT NOT NULL COMMENT '任务ID',

`user_id` BIGINT NOT NULL COMMENT '用户ID',

`status` VARCHAR(20) DEFAULT 'unfinished' COMMENT '状态：unfinished/completed',

`start_time` DATETIME DEFAULT NULL COMMENT '开始时间',

`finish_time` DATETIME DEFAULT NULL COMMENT '完成时间',

`duration_minutes` INT DEFAULT NULL COMMENT '耗时（分钟）',

`remark` VARCHAR(1000) DEFAULT NULL COMMENT '备注',

`total_score` DECIMAL(5,2) DEFAULT NULL COMMENT '总成绩',

`submit_time` DATETIME DEFAULT NULL COMMENT '提交时间',

`create_by` BIGINT DEFAULT NULL COMMENT '创建人',
`create_time` DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',

`update_by` BIGINT DEFAULT NULL COMMENT '修改人',
`update_time` DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',

UNIQUE KEY `uk_task_user` (`task_id`, `user_id`)

) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='任务分配表';



CREATE TABLE `task_score` (
`id` BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',

`task_user_id` BIGINT NOT NULL COMMENT '任务分配ID',

`module_name` VARCHAR(100) NOT NULL COMMENT '模块名称',

`score` DECIMAL(5,2) DEFAULT NULL COMMENT '分数',

`create_by` BIGINT DEFAULT NULL COMMENT '创建人',
`create_time` DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',

`update_by` BIGINT DEFAULT NULL COMMENT '修改人',
`update_time` DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间'

) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='任务成绩表';



CREATE TABLE `sys_dict` (
`id` BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',

`dict_code` VARCHAR(100) NOT NULL COMMENT '字典编码',

`dict_name` VARCHAR(200) NOT NULL COMMENT '字典名称',

`dict_value` VARCHAR(200) NOT NULL COMMENT '字典值',

`sort_no` INT DEFAULT 0 COMMENT '排序',

`status` TINYINT DEFAULT 1 COMMENT '状态：1正常 0禁用',

`create_by` BIGINT DEFAULT NULL COMMENT '创建人',
`create_time` DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',

`update_by` BIGINT DEFAULT NULL COMMENT '修改人',
`update_time` DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间'

) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='字典表';



CREATE TABLE notification_message (
id BIGINT PRIMARY KEY AUTO_INCREMENT,

user_id BIGINT NOT NULL COMMENT '接收用户',

title VARCHAR(100) COMMENT '标题',

content VARCHAR(500) COMMENT '内容',

`priority` INT DEFAULT 0 COMMENT '消息优先级',

type VARCHAR(30) COMMENT '消息类型',

related_id BIGINT COMMENT '关联业务id',

is_read TINYINT DEFAULT 0 COMMENT '是否已读',

created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);