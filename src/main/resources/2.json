CREATE TABLE `task_template` (
`id` bigint(20) NOT NULL AUTO_INCREMENT COMMENT '主键ID',
`template_name` varchar(200) NOT NULL COMMENT '模板名称',
`task_type` varchar(50) NOT NULL COMMENT '任务类型',
`is_mandatory` tinyint(4) DEFAULT '0' COMMENT '是否强制',
`task_description` text COMMENT '模板描述',
`default_priority` int(11) DEFAULT '0' COMMENT '默认优先级',
`create_by` bigint(20) DEFAULT NULL COMMENT '创建人',
`create_time` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
`update_by` bigint(20) DEFAULT NULL COMMENT '修改人',
`update_time` datetime DEFAULT CURRENT_TIMESTAMP
ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='任务模板表';

1.任务管理下面拆成两个子菜单，一个任务管理，一个模板任务管理
2.模板任务管理新增，参数就是表里面的参数。
3.任务管理，新增的时候先选，是否模板任务，选择是，使用模板任务的名称，任务类型，是否强制，模板描述，默认优先级作为任务优先级。轮次为模板任务表中的已有轮次+1
        新增任务后，模板任务的轮次+1，任务新增和模板任务的修改放到一个事务里面。



-- kg_db.task definition

CREATE TABLE `task` (
`id` bigint(20) NOT NULL AUTO_INCREMENT COMMENT '主键ID',
`is_template` tinyint(4) DEFAULT '0' COMMENT '是否模板：1是 0否',
`template_task_id` bigint(20) DEFAULT NULL COMMENT '模板任务ID',
`round_no` int(11) DEFAULT '0' COMMENT '轮次，模板为0',
`task_start_time` datetime DEFAULT NULL COMMENT '任务开始时间',
`task_end_time` datetime DEFAULT NULL COMMENT '任务结束时间',
`class_id` bigint(20) DEFAULT NULL COMMENT '班级ID',
`create_by` bigint(20) DEFAULT NULL COMMENT '创建人',
`create_time` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
`update_by` bigint(20) DEFAULT NULL COMMENT '修改人',
`update_time` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=12 DEFAULT CHARSET=utf8mb4 COMMENT='任务表';